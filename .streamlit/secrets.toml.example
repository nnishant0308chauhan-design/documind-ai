# =====================================================================
# DocuMind AI - Streamlit secrets template
# =====================================================================
# 1. Copy this file to:  .streamlit/secrets.toml   (same folder)
# 2. Replace the placeholder with your real Google Gemini API key.
# 3. Restart the app. The key is read ONLY by the Python backend.
#
# .streamlit/secrets.toml is listed in .gitignore - never commit it.
# Get a free key: https://aistudio.google.com/
# =====================================================================

GEMINI_API_KEY = "your_google_gemini_api_key_here"

# Optional: central model setting (default: gemini-3.5-flash)
GEMINI_MODEL = "gemini-3.5-flash"

# Optional: set to true ONLY for yourself to reveal the "Administrator diagnostics"
# panel in Settings (connection test, model name). Keep false/absent for public users.
DOCUMIND_ADMIN = false
