# =====================================================================
# DocuMind AI - Environment Variables Template
# =====================================================================
# Instructions:
# 1. Copy this file and rename it to ".env"
# 2. Replace the placeholder below with your real Google Gemini API key
# NOTE: the preferred location is .streamlit/secrets.toml (see secrets.toml.example).
#       .env is only a fallback if secrets.toml is absent.
# 3. Obtain a free key from Google AI Studio: https://aistudio.google.com/
# =====================================================================

GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: Default Gemini model (e.g., gemini-3.5-flash, gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash
